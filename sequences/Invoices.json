    {
        "name":"Load SFDC Data",
        "typeofcomparison":"Read Excel Data",
        "savetoexcel": false,
        "path": "./database/Access Invoice & Line ltem.xlsx",
        "registertable":"SFDC_INVOICES"
    },
    {
        "name":"Join SFDC SAP",
        "typeofcomparison":"Custom",
        "path":"./querys/custom/joinInnerQueryInvoices.sql",
        "savetoexcel": true,
        "displaycolumns": "All",
        "registertable":"joined_sap_sfdc"
    },
    {
        "name":"Outer SFDC SAP",
        "typeofcomparison":"Custom",
        "path":"./querys/custom/joinOuterQueryInvoices.sql",
        "savetoexcel": true,
        "displaycolumns": "All",
        "registertable":"outerjoined_sap_sfdc"
    },
    {
        "name": "Net Value Mismatch (not final)",
        "savetoexcel": true,
        "typeofcomparison": "Amount Difference",
        "table1": "joined_sap_sfdc",
        "column1": "Net Value",
        "column2": "Net Value in Document Curr",
        "threshold": 10,
        "displaycolumns": [
            "Billing Document",
            "Line Number",
            "Net Value",
            "Net Value in Document Curr",
            "Net value in document currency in advanc"
        ],
        "registertable": "Net_Value_Mismatch",
        "comment": "Check for net value differences greater than threshold. This first line only compares to future payments. Any advanced payment will actually get flagged as a mismatch at this point."
    },
    {
        "name": "Net Value Mismatch",
        "savetoexcel": true,
        "typeofcomparison": "Amount Difference",
        "table1": "Net_Value_Mismatch",
        "column1": "Net Value",
        "column2": "Net value in document currency in advanc",
        "threshold": 10,
        "displaycolumns": [
            "Billing Document",
            "Line Number",
            "Net Value",
            "Net Value in Document Curr",
            "Net value in document currency in advanc"
        ],
        "registertable": false,
        "comment": "Here we compare the results of the previous comparisson so that we can remove all the lines that are not actually a mismatch since the amount was payed in advacned."
    },
    {
        "name": "Tax Value Mismatch",
        "savetoexcel": true,
        "typeofcomparison": "Amount Difference",
        "table1": "joined_sap_sfdc",
        "column1": "Tax",
        "column2": "Tax Value",
        "threshold": 1,
        "displaycolumns": [
            "Billing Document",
            "Line Number",
            "Tax",
            "Tax Value"
        ],
        "registertable": false,
        "comment": "Check for net value differences greater than threshold"
    },
    {
        "name": "Commision Value Mismatch",
        "savetoexcel": true,
        "typeofcomparison": "Amount Difference",
        "table1": "joined_sap_sfdc",
        "column1": "ZC20 - Condition type",
        "column2": "Commission AMount Formula",
        "threshold": 0,
        "displaycolumns": [
            "Billing Document",
            "Line Number",
            "ZC20 - Condition type",
            "Commission AMount Formula"
        ],
        "registertable": false,
        "comment": "Check for net value differences greater than threshold"
    },
    {
        "name":"Bill Qty Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Amount Difference",
        "threshold": 0,
        "column1":"Billed QTY",
        "column2":"Bill QTY",
        "registertable": false,
        "displaycolumns":["Billing Document","Line Number","Billed QTY","Bill QTY"]
    },
    {
        "name":"Sold to party Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Customer Code",
        "column2":"Customer SAP Code",
        "displaycolumns":["Billing Document","Line Number","Customer Code","Sold to Customer Code"]
    },
    {
        "name":"Argentine Factura Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Argentine Factura",
        "column2":"Invoice Number (External)",
        "displaycolumns":["Billing Document","Line Number","Argentine Factura","Invoice Number (External)"]
    },
    {
        "name":"Argentine Remito Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Argentine Remito",
        "column2":"Dispatch Number (External)",
        "displaycolumns":["Billing Document","Line Number","Argentine Remito","Dispatch Number (External)"]
    },
    {
        "name":"Batch Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Batch",
        "column2":"Batch_1",
        "displaycolumns":["Billing Document","Line Number","Batch","Batch_1"]
    }
]