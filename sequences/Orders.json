[
    {
        "name":"Load SAP Data",
        "typeofcomparison":"Read Excel Data",
        "savetoexcel": false,
        "path": "./database/2026/SAP Orders.xlsx",
        "registertable":"SAP_ORDERS_LINEITEMS"
    },
    {
        "name":"Load SFDC Orders Data",
        "typeofcomparison":"Read Excel Data",
        "savetoexcel": false,
        "path": "./database/Access - Integrity Order Report.xlsx",
        "registertable":"SFDC_ORDERS"
    },
    {
        "name":"Unify Items",
        "typeofcomparison":"Custom",
        "savetoexcel": false,
        "path":"./querys/custom/unify_SAP_LineItems.sql",
        "displaycolumns": "All",
        "registertable":"SAP_ORDERS",
        "comment":"This query is not adapted yet for parameter calling. It is Hardcoded, so previous actions should not be modified if this query is being used."
    },
    {
        "name":"Join Inner SFDC SAP",
        "typeofcomparison":"Inner Join",
        "savetoexcel": true,
        "table1":"SAP_ORDERS",
        "table2":"SFDC_ORDERS",
        "column1":"Sales Document",
        "column2":"SAP Order Number",
        "displaycolumns": "All",
        "registertable":"joined_sap_sfdc"
    },
    {
        "name":"Outer Inner SFDC SAP",
        "typeofcomparison":"Outer Join",
        "savetoexcel": true,
        "table1":"SAP_ORDERS",
        "table2":"SFDC_ORDERS",
        "column1":"Sales Document",
        "column2":"SAP Order Number",
        "displaycolumns": "All",
        "registertable":"joined_sap_sfdc"
    },
    {
        "name": "Ammount Mismatch",
        "savetoexcel": true,
        "typeofcomparison": "Amount Difference",
        "table1": "joined_sap_sfdc",
        "column1": "Importe Neto",
        "column2": "Total Value",
        "threshold": 10,
        "displaycolumns": [
            "Sales Document",
            "Billing Date",
            "Cust. Code",
            "Order Amount",
            "Importe Neto",
            "Total Value"
        ],
        "registertable": false
    },
    {
        "name":"Territory Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Customer Group 2",
        "column2":"Sales Office: Territory Code",
        "displaycolumns":[
            "Sales Document",
            "Sales Office: Territory Code",
            "Customer Group 2",
            "Billing Date"
        ]
    },
    {
        "name":"Cons. Code Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Parcial Match",
        "column1":"Cons. Code",
        "column2":"Shipping Address",
        "displaycolumns":[
            "Sales Document",
            "Cons. Code",
            "Shipping Address",
            "Billing Date"
        ],
        "comment":"The order of the columns is relevant. The entire code in column1 will be validated if it is inside column 2. So column1 should be contained inside column two, not the other way around."
    },
    {
        "name":"Tax Number Mismatch",
        "savetoexcel":true,
        "table1":"joined_sap_sfdc",
        "typeofcomparison":"Total Match",
        "column1":"Tax Number 1 (CNPJ No.)",
        "column2":"Account Name: SAP Tax Number 1",
        "displaycolumns":[
            "Sales Document",
            "Account Name: SAP Tax Number 1",
            "Tax Number 1 (CNPJ No.)"
        ]
    }
]