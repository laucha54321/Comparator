{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "querys",
    "title": "querys",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "typeofcomparison": { 
                "type": "string",
                "enum": ["Total Match", "Inner Join", "Parcial Match"]
            },
            "sapcolumn": { "type": "string" },
            "sfdccolumn": { "type": "string" },
            "displaycolumns": { 
                "anyOf": [
                    { "type": "array", "items": { "type": "string" } },
                    { "type": "string" }
                ]
            },
            "registertable":{"type":"string"},
            "table":{"type":"string"}
        },
        "required": ["typeofcomparison", "sapcolumn", "sfdccolumn", "displaycolumns"]
    }
}
