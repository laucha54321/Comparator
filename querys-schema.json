{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "querys",
    "title": "querys",
    "type": "array",
    "items": { 
        "anyOf": [
            {   
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "typeofcomparison": { 
                        "type": "string",
                        "enum": ["Total Match", "Parcial Match", "Inner Join", "Combine Two Columns"]
                    },
                    "column1": { "type": "string" },
                    "column2": { "type": "string" },
                    "savetoexcel":{ "type":"boolean" },
                    "displaycolumns": { 
                        "anyOf": [
                            { "type": "array", "items": { "type": "string" } },
                            { "type": "string" }
                        ]
                    },
                    "registertable": {"anyOf":[{"type":"string"},{"type":"boolean"}]},
                    "table":{"type":"string"}
                },
                "required": ["typeofcomparison", "column1", "column2", "displaycolumns"]
            },
            {   
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "typeofcomparison": { 
                        "type": "string",
                        "enum": ["Custom"]
                    },
                    "savetoexcel":{ "type":"boolean" },
                    "path":{ "type": "string" },
                    "displaycolumns": { 
                        "anyOf": [
                            { "type": "array", "items": { "type": "string" } },
                            { "type": "string" }
                        ]
                    },
                    "registertable": {"anyOf":[{"type":"string"},{"type":"boolean"}]}
                },
                "required": ["typeofcomparison", "displaycolumns"]
            },
            {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "path": { "type": "string" },
                    "typeofcomparison": {
                        "type": "string",
                        "enum": ["Read Excel Data"]
                    },
                    "savetoexcel": {
                        "type": "boolean",
                        "default": false
                    }
    
                },
                "required": ["name", "path", "typeofcomparison"]
            }
        ]
    }
}
